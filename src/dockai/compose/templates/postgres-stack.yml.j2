# Generated by dockai for stack "{{ stack }}". Re-generated on every compose_up; do not edit by hand.
# The password lives in .env next to this file (git-ignored), never in this file.
name: {{ stack }}

services:
  postgres:
    image: postgres:{{ postgres_version }}
    container_name: {{ stack }}-postgres
    restart: unless-stopped
    env_file: .env
    environment:
      POSTGRES_DB: {{ database }}
      POSTGRES_USER: {{ user }}
    ports:
      - "127.0.0.1:{{ postgres_port }}:5432"
    volumes:
      - pgdata:{{ pgdata_mount }}
    networks: [net]
    labels:
      managed-by: dockai
      dockai.stack: {{ stack }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ user }} -d {{ database }}"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s
{% if with_adminer %}

  adminer:
    image: adminer:latest
    container_name: {{ stack }}-adminer
    restart: unless-stopped
    environment:
      ADMINER_DEFAULT_SERVER: postgres
    ports:
      - "127.0.0.1:{{ adminer_port }}:8080"
    networks: [net]
    depends_on:
      postgres:
        condition: service_healthy
    labels:
      managed-by: dockai
      dockai.stack: {{ stack }}
    healthcheck:
      test: ["CMD", "php", "-r", "exit(@fsockopen('127.0.0.1', 8080) ? 0 : 1);"]
      interval: 5s
      timeout: 3s
      retries: 10
{% endif %}

volumes:
  pgdata:
    labels:
      managed-by: dockai
      dockai.stack: {{ stack }}

networks:
  net:
    labels:
      managed-by: dockai
      dockai.stack: {{ stack }}
