# Copy to .env and fill in. .env is git-ignored.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model id
# GEMINI_MODEL=gemini-3.8-flash
# Models tried in order when the main one is overloaded (503/429)
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: Postgres password for stacks. Leave empty to generate a random one per stack.
# POSTGRES_PASSWORD=

# Optional: default host port for Adminer (8080 if unset)
# DOCKAI_ADMINER_PORT=8081

# Optional: command that starts the MCP server the client connects to over stdio.
# Default: this project's own server (python -m dockai.server).
# DOCKAI_MCP_COMMAND=docker mcp gateway run

# Optional: cap on LLM <-> tool round trips per prompt
# DOCKAI_MAX_ITERATIONS=8
